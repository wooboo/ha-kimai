{
  "entity": {
    "calendar": {
      "timesheets": { "default": "mdi:calendar-clock" }
    },
    "sensor": {
      "month_hours": { "default": "mdi:calendar-month" },
      "today_hours": { "default": "mdi:clock-check-outline" },
      "week_hours": { "default": "mdi:calendar-week" }
    }
  },
  "services": {
    "get_day_hours": {
      "service": "mdi:clock-search-outline"
    },
    "log_time": {
      "service": "mdi:timer-plus-outline"
    },
    "set_day_hours": {
      "service": "mdi:clock-edit-outline"
    }
  }
}
